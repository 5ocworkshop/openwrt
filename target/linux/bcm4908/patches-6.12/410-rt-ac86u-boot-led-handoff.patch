+static bool rtac86u_zone_ready(const struct rtac86u_wp_snapshot *snapshot)
+{
+	return !snapshot->failed && snapshot->completed_mask == 0xf &&
+		snapshot->active_zone == 4 && snapshot->substep == 4;
+}
+
+/* Caller owns leds->lock. Only channels 16..21 belong to diagnostics. */
+static void rtac86u_zone_finish_render(struct bcm63138_leds *leds)
+{
+	struct bcm63138_led led = {};
+	unsigned int step = leds->zone_finish_step;
+	u32 mask = 0;
+
+	if (step >= 1 && step <= 4)
+		mask = GENMASK(19, 15 + step);
+	if ((step >= 1 && step <= 5) || step == 8)
+		mask |= BIT(21);
+	else if (step == 6)
+		mask |= BIT(20);
+	for (led.pin = 16; led.pin <= 21; led.pin++) {
+		bcm63138_leds_set_flash_rate(leds, &led, 0);
+		bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
+		bcm63138_leds_enable_led(leds, &led, mask & BIT(led.pin));
+	}
+}
+
 static void rtac86u_zone_timer(struct timer_list *timer)
 {
+	static const unsigned int finish_hold_ms[] = {
+		1000, 300, 250, 200, 150, 300, 300, 300,
+	};
 	struct bcm63138_leds *leds = from_timer(leds, timer, zone_timer);
 	struct rtac86u_wp_snapshot snapshot;
 	unsigned long flags;
@@ -238,7 +271,32 @@
 
 	rtac86u_wp_snapshot(&snapshot);
 	spin_lock_irqsave(&leds->lock, flags);
-	if (leds->bootzones && !leds->bootdiag_panicked) {
+	if (leds->bootzones && !leds->zone_released && !leds->bootdiag_panicked) {
+		if (leds->zone_finish_step) {
+			/* Refresh after taking the output lock, including final release. */
+			rtac86u_wp_snapshot(&snapshot);
+			if (!rtac86u_zone_ready(&snapshot)) {
+				leds->zone_finish_step = 0;
+			} else {
+				/* An older in-flight callback must not shorten this hold. */
+				if (time_before(jiffies, leds->zone_finish_due))
+					goto out;
+				if (++leds->zone_finish_step > 8) {
+					leds->zone_finish_step = 0;
+					rtac86u_zone_finish_render(leds);
+					leds->zone_released = true;
+					leds->bootdiag = false;
+				} else {
+					rtac86u_zone_finish_render(leds);
+					leds->zone_finish_due =
+						jiffies + msecs_to_jiffies(finish_hold_ms[
+							leds->zone_finish_step - 1]);
+					mod_timer(&leds->zone_timer,
+						  leds->zone_finish_due);
+				}
+				goto out;
+			}
+		}
 		if (snapshot.active_zone != leds->zone_cached.active_zone ||
 		    snapshot.substep != leds->zone_cached.substep ||
 		    snapshot.completed_mask != leds->zone_cached.completed_mask)
@@ -252,6 +310,7 @@
 	}
 	if (rearm)
 		mod_timer(&leds->zone_timer, jiffies + msecs_to_jiffies(150));
+out:
 	spin_unlock_irqrestore(&leds->lock, flags);
 }
 
@@ -355,18 +414,87 @@
 	return 0;
 }
 
+/*
+ * The controller timer renders completion frames asynchronously. Its output
+ * lock also serializes requests, normal callbacks, panic reclaim and removal.
+ */
+static int rtac86u_zone_release(struct bcm63138_leds *leds)
+{
+	struct rtac86u_wp_snapshot snapshot;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&leds->lock, flags);
+	rtac86u_wp_snapshot(&snapshot);
+	if (!leds->bootzones) {
+		err = -EOPNOTSUPP;
+	} else if (leds->bootdiag_panicked || snapshot.failed) {
+		err = -EBUSY;
+	} else if (!leds->zone_released) {
+		if (!rtac86u_zone_ready(&snapshot)) {
+			err = -EBUSY;
+		} else if (!leds->zone_finish_step) {
+			leds->zone_finish_step = 1;
+			rtac86u_zone_finish_render(leds);
+			leds->zone_finish_due = jiffies + msecs_to_jiffies(1000);
+			mod_timer(&leds->zone_timer, leds->zone_finish_due);
+		}
+	}
+	spin_unlock_irqrestore(&leds->lock, flags);
+	return err;
+}
+
+/*
+ * One sysfs transaction validates core-owned startup facts and starts the
+ * existing sequence. Repeated healthy requests never replay facts or timers.
+ */
+static int rtac86u_zone_complete(struct bcm63138_leds *leds)
+{
+	struct rtac86u_wp_snapshot snapshot;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&leds->lock, flags);
+	rtac86u_wp_snapshot(&snapshot);
+	if (!leds->bootzones) {
+		err = -EOPNOTSUPP;
+	} else if (leds->bootdiag_panicked || snapshot.failed) {
+		err = -EBUSY;
+	} else if (!leds->zone_released && !leds->zone_finish_step) {
+		if (!rtac86u_wp_finish_startup()) {
+			err = -EBUSY;
+		} else {
+			leds->zone_finish_step = 1;
+			rtac86u_zone_finish_render(leds);
+			leds->zone_finish_due = jiffies + msecs_to_jiffies(1000);
+			mod_timer(&leds->zone_timer, leds->zone_finish_due);
+		}
+	}
+	spin_unlock_irqrestore(&leds->lock, flags);
+	return err;
+}

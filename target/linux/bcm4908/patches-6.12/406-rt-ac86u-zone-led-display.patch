+
+/* One 150 ms tick per half-pulse, followed by at least 900 ms quiet. */
+static unsigned int rtac86u_zone_substep(unsigned int step)
+{
+	return !step ? 1 : step > 4 ? 4 : step;
+}
+
+static u32 rtac86u_zone_lan_mask(unsigned int completed, unsigned int zone,
+			       unsigned int step, unsigned int tick, bool failed)
+{
+	u32 mask = 0;
+	unsigned int bit, count = rtac86u_zone_substep(step);
+
+	for (bit = 0; bit < 4; bit++)
+		if (completed & BIT(bit))
+			mask |= BIT(19 - bit);
+	if (!zone || zone > 4)
+		return mask;
+	if (!(completed & BIT(zone - 1)) || failed) {
+		mask &= ~BIT(20 - zone);
+		tick %= count * 2 + 6;
+		if (tick < count * 2 && !(tick & 1))
+			mask |= BIT(20 - zone);
+	}
+	return mask;
+}
+
+/* Caller owns leds->lock. Keep the white WAN anchor on, also in panic. */
+static void rtac86u_zone_render(struct bcm63138_leds *leds, u32 mask, bool panic)
+{
+	struct bcm63138_led led = {};
+
+	for (led.pin = 16; led.pin <= 19; led.pin++) {
+		bcm63138_leds_set_flash_rate(leds, &led, 0);
+		bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
+		bcm63138_leds_enable_led(leds, &led, mask & BIT(led.pin));
+	}
+	led.pin = 21;
+	bcm63138_leds_set_flash_rate(leds, &led, 0);
+	bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
+	bcm63138_leds_enable_led(leds, &led, BCM63138_MAX_BRIGHTNESS);
+	if (!panic) {
+		led.pin = 20;
+		bcm63138_leds_set_flash_rate(leds, &led, 0);
+		bcm63138_leds_enable_led(leds, &led, LED_OFF);
+	}
+}
+
+static void rtac86u_zone_timer(struct timer_list *timer)
+{
+	struct bcm63138_leds *leds = from_timer(leds, timer, zone_timer);
+	struct rtac86u_wp_snapshot snapshot;
+	unsigned long flags;
+	bool rearm = false;
+
+	rtac86u_wp_snapshot(&snapshot);
+	spin_lock_irqsave(&leds->lock, flags);
+	if (leds->bootzones && !leds->bootdiag_panicked) {
+		if (snapshot.active_zone != leds->zone_cached.active_zone ||
+		    snapshot.substep != leds->zone_cached.substep ||
+		    snapshot.completed_mask != leds->zone_cached.completed_mask)
+			leds->zone_tick = 0;
+		leds->zone_cached = snapshot;
+		rtac86u_zone_render(leds, rtac86u_zone_lan_mask(
+			snapshot.completed_mask, snapshot.active_zone,
+			snapshot.substep, leds->zone_tick++, snapshot.failed), false);
+		leds->zone_tick %= rtac86u_zone_substep(snapshot.substep) * 2 + 6;
+		rearm = true;
+	}
+	if (rearm)
+		mod_timer(&leds->zone_timer, jiffies + msecs_to_jiffies(150));
+	spin_unlock_irqrestore(&leds->lock, flags);
+}
+
+/* No lock is retained across a panic polling delay. */
+static bool rtac86u_zone_panic_write(const struct rtac86u_wp_snapshot *snapshot,
+				     bool on)
+{
+	struct bcm63138_leds *leds;
+	unsigned long flags;
+	bool written = false;
+
+	if (!spin_trylock_irqsave(&rtac86u_bootdiag_lock, flags))
+		return false;
+	leds = rtac86u_bootdiag_controller;
+	if (leds && spin_trylock(&leds->lock)) {
+		if (leds->bootzones && leds->bootdiag_panicked) {
+			rtac86u_zone_render(leds, rtac86u_zone_lan_mask(
+				snapshot->completed_mask, snapshot->active_zone,
+				snapshot->substep, on ? 0 : 1, true), true);
+			written = true;
+		}
+		spin_unlock(&leds->lock);
+	}
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	return written;
+}
+
+static long rtac86u_zone_panic_blink(int state)
+{
+	struct rtac86u_wp_snapshot snapshot;
+	struct bcm63138_leds *leds;
+	unsigned long flags;
+	unsigned int pulse, count;
+	long elapsed = 0;
+	bool available = false;
+
+	if (!spin_trylock_irqsave(&rtac86u_bootdiag_lock, flags))
+		return 0;
+	leds = rtac86u_bootdiag_controller;
+	if (leds && spin_trylock(&leds->lock)) {
+		if (leds->bootzones && leds->bootdiag_panicked) {
+			snapshot = leds->zone_panic;
+			available = true;
+		}
+		spin_unlock(&leds->lock);
+	}
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	if (!available || !snapshot.active_zone || snapshot.active_zone > 4)
+		return 0;
+	count = rtac86u_zone_substep(snapshot.substep);
+	for (pulse = 0; pulse < count; pulse++) {
+		if (!rtac86u_zone_panic_write(&snapshot, true))
+			break;
+		mdelay(150);
+		elapsed += 150;
+		if (!rtac86u_zone_panic_write(&snapshot, false))
+			break;
+		mdelay(150);
+		elapsed += 150;
+	}
+	/* kernel/panic.c accounts elapsed and supplies its 1800 ms inter-burst gap. */
+	return elapsed;
+}
+
+static int rtac86u_zone_parse(const char *buf, size_t count, unsigned int *zone,
+			      unsigned int *step, unsigned int *phase)
+{
+	unsigned int values[3] = {};
+	unsigned int field = 0;
+	size_t i;
+	bool token = false;
+
+	if (!count || count > 32)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		unsigned char c = buf[i];
+
+		if (isdigit(c)) {
+			if (field >= 3)
+				return -EINVAL;
+			values[field] = values[field] * 10 + c - '0';
+			if (values[field] > 4)
+				return -EINVAL;
+			token = true;
+		} else if (isspace(c)) {
+			if (token) {
+				field++;
+				token = false;
+			}
+		} else {
+			return -EINVAL;
+		}
+	}
+	if (token)
+		field++;
+	if (field != 3 || !values[0] || !values[1] || values[2] > 2)
+		return -EINVAL;
+	*zone = values[0];
+	*step = values[1];
+	*phase = values[2];
+	return 0;
+}
+
+static ssize_t boot_waypoint_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct rtac86u_wp_snapshot snapshot;
+
+	rtac86u_wp_snapshot(&snapshot);
+	return sysfs_emit(buf,
+		"completed=%x zone=%u step=%u failed=%u site=%u errno=%d root_dev=%u root_disk=%u\n",
+		snapshot.completed_mask, snapshot.active_zone, snapshot.substep,
+		snapshot.failed, snapshot.site, snapshot.error,
+		snapshot.root_dev, snapshot.root_disk);
+}
+
+static ssize_t boot_waypoint_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct bcm63138_leds *leds = dev_get_drvdata(dev);
+	unsigned int zone, step, phase;
+	int err;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!READ_ONCE(leds->bootzones))
+		return -EOPNOTSUPP;
+	err = rtac86u_zone_parse(buf, count, &zone, &step, &phase);
+	if (err)
+		return err;
+	if (READ_ONCE(leds->bootdiag_panicked))
+		return -EBUSY;
+	rtac86u_wp_step(zone, step, phase);
+	return count;
+}
+static DEVICE_ATTR_RW(boot_waypoint);

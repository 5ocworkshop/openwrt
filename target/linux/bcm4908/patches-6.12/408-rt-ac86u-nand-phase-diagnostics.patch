+static unsigned int rtac86u_wp_storage_phase_locked(void)
+{
+	struct rtac86u_wp_snapshot *s = &wp.snapshot;
+
+	if (!(s->storage_seen & RTAC86U_WP_SEEN_SCAN) || s->nand_scan_result)
+		return 1;
+	if ((s->storage_seen & RTAC86U_WP_SEEN_PROBE) && s->nand_probe_result &&
+	    (!(s->storage_seen & RTAC86U_WP_SEEN_MTD) || !s->mtd_register_result))
+		return 1;
+	if (!(s->storage_seen & RTAC86U_WP_SEEN_MTD) || s->mtd_register_result ||
+	    !(((s->storage_seen & RTAC86U_WP_SEEN_LOOKUP) &&
+	       !s->ubi_lookup_result) ||
+	      ((s->storage_seen & RTAC86U_WP_SEEN_FALLBACK) &&
+	       !s->ubi_fallback_result)))
+		return 2;
+	if (!(s->storage_seen & RTAC86U_WP_SEEN_MAGIC) ||
+	    !(s->storage_seen & RTAC86U_WP_SEEN_LENGTH) ||
+	    (s->ubi_magic_result && s->ubi_magic_result != -EUCLEAN) ||
+	    s->ubi_magic_length != 4 ||
+	    !(s->storage_seen & RTAC86U_WP_SEEN_VALIDATION) || !s->ubi_magic_found)
+		return 3;
+	return 4;
+}
+
+static bool rtac86u_wp_storage_event_locked(unsigned int event,
+					   unsigned int value, int error)
+{
+	struct rtac86u_wp_snapshot *s = &wp.snapshot;
+
+	if (event == RTAC86U_WP_PLATFORM_PHASE_DONE) {
+		/* A traversed phase does not manufacture individual probe successes. */
+		s->completed_mask |= BIT(0);
+		return true;
+	}
+	if (!wp.precise)
+		return false;
+	switch (event) {
+	case RTAC86U_WP_NAND_PROBE_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_PROBE;
+		s->nand_probe_result = error;
+		if (error && !(s->storage_seen & RTAC86U_WP_SEEN_SCAN))
+			rtac86u_wp_step_locked(2, 1, RTAC86U_WP_ERROR);
+		break;
+	case RTAC86U_WP_NAND_SCAN_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_SCAN;
+		s->nand_scan_result = error;
+		s->nand_id = value & 0xffff;
+		s->nand_id_length = value >> 16;
+		rtac86u_wp_step_locked(2, 1, error ? RTAC86U_WP_ERROR : RTAC86U_WP_DONE);
+		break;
+	case RTAC86U_WP_MTD_REGISTER_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_MTD;
+		s->mtd_register_result = error;
+		rtac86u_wp_step_locked(2, 2, error ? RTAC86U_WP_ERROR : RTAC86U_WP_ENTER);
+		break;
+	case RTAC86U_WP_UBI_LOOKUP_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_LOOKUP;
+		s->ubi_lookup_result = error;
+		if (!error)
+			s->ubi_mtd_index = value;
+		rtac86u_wp_step_locked(2, 2, error ? RTAC86U_WP_ERROR : RTAC86U_WP_ENTER);
+		break;
+	case RTAC86U_WP_UBI_FALLBACK_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_FALLBACK;
+		s->ubi_fallback_result = error;
+		if (!error)
+			s->ubi_mtd_index = value;
+		break;
+	case RTAC86U_WP_UBI_MAGIC_READ_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_MAGIC;
+		s->ubi_magic_result = error;
+		s->ubi_magic = value;
+		rtac86u_wp_step_locked(2, 3, error && error != -EUCLEAN ?
+			RTAC86U_WP_ERROR : RTAC86U_WP_ENTER);
+		break;
+	case RTAC86U_WP_UBI_MAGIC_LENGTH:
+		s->storage_seen |= RTAC86U_WP_SEEN_LENGTH;
+		s->ubi_magic_length = value;
+		break;
+	case RTAC86U_WP_UBI_MAGIC_FOUND:
+		s->storage_seen |= RTAC86U_WP_SEEN_VALIDATION;
+		s->ubi_magic_found = !!value;
+		if (value && s->ubi_magic_length == 4 &&
+		    (!s->ubi_magic_result || s->ubi_magic_result == -EUCLEAN))
+			rtac86u_wp_step_locked(2, 3, RTAC86U_WP_DONE);
+		break;
+	case RTAC86U_WP_UBI_ATTACH_RESULT:
+		s->storage_seen |= RTAC86U_WP_SEEN_ATTACH;
+		s->ubi_attach_result = error;
+		if (error >= 0)
+			wp.ubi_attached = true;
+		rtac86u_wp_step_locked(2, 4, error < 0 ? RTAC86U_WP_ERROR : RTAC86U_WP_DONE);
+		break;
+	default:
+		return false;
+	}
+	if ((s->storage_seen & RTAC86U_WP_SEEN_MTD) && !s->mtd_register_result &&
+	    (((s->storage_seen & RTAC86U_WP_SEEN_LOOKUP) &&
+	      !s->ubi_lookup_result) ||
+	     ((s->storage_seen & RTAC86U_WP_SEEN_FALLBACK) &&
+	      !s->ubi_fallback_result)))
+		rtac86u_wp_step_locked(2, 2, RTAC86U_WP_DONE);
+	return true;
+}

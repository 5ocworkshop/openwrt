+		}
 		data_page = page_address(p);
 		strscpy_pad(data_page, data, PAGE_SIZE);
 	}
@@ -179,6 +185,7 @@
 out:
 	if (p)
 		put_page(p);
+	rtac86u_rootdiag_checkpoint(stage, ret ? 2 : 1);
 	return ret;
 }
 
@@ -189,6 +196,7 @@
 	char *p;
 	char b[BDEVNAME_SIZE];
 	int num_fs, i;
+	int last_error = 0;
 
 	scnprintf(b, BDEVNAME_SIZE, "unknown-block(%u,%u)",
 		  MAJOR(ROOT_DEV), MINOR(ROOT_DEV));
@@ -203,13 +211,16 @@
 		if (!*p)
 			continue;
 		err = do_mount_root(name, p, flags, root_mount_data);
+		last_error = err;
 		switch (err) {
 			case 0:
 				goto out;
 			case -EACCES:
 			case -EINVAL:
 #ifdef CONFIG_BLOCK

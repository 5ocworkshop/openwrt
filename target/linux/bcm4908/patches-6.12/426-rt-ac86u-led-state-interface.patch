@@ -284,6 +306,7 @@
 				if (++leds->zone_finish_step > 8) {
 					leds->zone_finish_step = 0;
 					rtac86u_zone_finish_render(leds);
+					rtac86u_diag_invalidate(leds);
 					leds->zone_released = true;
 					leds->bootdiag = false;
 				} else {
@@ -655,6 +678,8 @@
 		spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
 		return NOTIFY_DONE;
 	}
+	if (!leds->bootdiag_panicked)
+		rtac86u_diag_invalidate(leds);
 	leds->zone_finish_step = 0;
 	leds->bootdiag_panicked = true;
 	leds->bootdiag = true;
@@ -685,12 +710,9 @@
 		bcm63138_leds_set_flash_rate(leds, &led, 6);
 		led.pin = 20;
 	}
-	bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
-	bcm63138_leds_enable_led(leds, &led, BCM63138_MAX_BRIGHTNESS);
-	bcm63138_leds_set_flash_rate(leds, &led, 6);
-	led.pin = 21;
-	bcm63138_leds_enable_led(leds, &led,
-		leds->bootzones ? BCM63138_MAX_BRIGHTNESS : LED_OFF);
+	if (!leds->bootzones && !(leds->rootdiag && leds->rootdiag_fatal))
+		rtac86u_diag_apply(leds,
+			rtac86u_bootdiag_lan_mask(leds->bootdiag_stage), true);
 	spin_unlock(&leds->lock);
 	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
 	return NOTIFY_DONE;
@@ -743,6 +765,7 @@
 	spin_lock_irqsave(&leds->lock, flags);
 	zones = leds->bootzones;
 	leds->bootzones = false;
+	rtac86u_diag_invalidate(leds);
 	leds->zone_finish_step = 0;
 	spin_unlock_irqrestore(&leds->lock, flags);
 	if (zones)


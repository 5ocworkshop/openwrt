-
-	for (led.pin = 16; led.pin <= 19; led.pin++) {
-		bcm63138_leds_set_flash_rate(leds, &led, 0);
-		bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
-		bcm63138_leds_enable_led(leds, &led, mask & BIT(led.pin));
-	}
-	led.pin = 21;
-	bcm63138_leds_set_flash_rate(leds, &led, 0);
-	bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
-	bcm63138_leds_enable_led(leds, &led, BCM63138_MAX_BRIGHTNESS);
-	if (!panic) {
-		led.pin = 20;
-		bcm63138_leds_set_flash_rate(leds, &led, 0);
-		bcm63138_leds_enable_led(leds, &led, LED_OFF);
-	}
+	rtac86u_diag_apply(leds, mask | BIT(21), panic);
 }
 
 static bool rtac86u_zone_ready(const struct rtac86u_wp_snapshot *snapshot)
@@ -242,7 +269,6 @@
 /* Caller owns leds->lock. Only channels 16..21 belong to diagnostics. */
 static void rtac86u_zone_finish_render(struct bcm63138_leds *leds)
 {
-	struct bcm63138_led led = {};
 	unsigned int step = leds->zone_finish_step;
 	u32 mask = 0;
 
@@ -252,11 +278,7 @@
 		mask |= BIT(21);
 	else if (step == 6)
 		mask |= BIT(20);
-	for (led.pin = 16; led.pin <= 21; led.pin++) {
-		bcm63138_leds_set_flash_rate(leds, &led, 0);
-		bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
-		bcm63138_leds_enable_led(leds, &led, mask & BIT(led.pin));
-	}
+	rtac86u_diag_apply(leds, mask, false);
 }
 

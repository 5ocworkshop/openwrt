 }
 
+
+/*
+ * Diagnostic-only owner of the physical LAN1..4 and WAN indicators.
+ * Never bypass the existing controller lock; ordinary LED callbacks are
+ * suppressed for these channels while diagnostics owns them.
+ */
+static DEFINE_SPINLOCK(rtac86u_bootdiag_lock);
+static struct bcm63138_leds *rtac86u_bootdiag_controller;
+
+static u32 rtac86u_bootdiag_lan_mask(unsigned int stage)
+{
+	u32 mask = 0;
+	unsigned int bit;
+
+	for (bit = 0; bit < 4; bit++)
+		if (stage & BIT(bit))
+			mask |= BIT(19 - bit);
+	return mask;
+}
+
+static void rtac86u_bootdiag_render(struct bcm63138_leds *leds,
+				   unsigned int stage, unsigned int phase)
+{
+	struct bcm63138_led led = {};
+	u32 mask = rtac86u_bootdiag_lan_mask(stage);
+
+	if (phase != 1)
+		mask |= BIT(20);
+	if (phase != 0)
+		mask |= BIT(21);
+	for (led.pin = 16; led.pin <= 21; led.pin++) {
+		bcm63138_leds_set_flash_rate(leds, &led, 0);
+		bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
+		bcm63138_leds_enable_led(leds, &led, mask & BIT(led.pin));
+	}
+	leds->bootdiag_stage = stage;
+	leds->bootdiag_phase = phase;
+}
+
+void rtac86u_bootdiag_checkpoint(unsigned int stage, unsigned int phase)
+{
+	struct bcm63138_leds *leds;
+	unsigned long flags;
+	bool changed = false;
+
+	if (!stage || stage > 15 || phase > 2)
+		return;
+	spin_lock_irqsave(&rtac86u_bootdiag_lock, flags);
+	leds = rtac86u_bootdiag_controller;
+	if (leds) {
+		spin_lock(&leds->lock);
+		if (!leds->bootdiag_panicked) {
+			rtac86u_bootdiag_render(leds, stage, phase);
+			changed = true;
+		}
+		spin_unlock(&leds->lock);
+	}
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	if (changed)
+		pr_info("rt-ac86u bootdiag: stage=%u phase=%u\n", stage, phase);
+}
+EXPORT_SYMBOL_GPL(rtac86u_bootdiag_checkpoint);
+
+void rtac86u_bootdiag_complete(unsigned int stage)
+{
+	struct bcm63138_leds *leds;
+	unsigned long flags;
+
+	spin_lock_irqsave(&rtac86u_bootdiag_lock, flags);
+	leds = rtac86u_bootdiag_controller;
+	if (leds) {
+		spin_lock(&leds->lock);
+		/* Preserve successful nested attachment or an explicit error. */
+		if (!leds->bootdiag_panicked && leds->bootdiag_stage == stage &&
+		    leds->bootdiag_phase == 0)
+			rtac86u_bootdiag_render(leds, stage, 1);
+		spin_unlock(&leds->lock);
+	}
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+}
+
+EXPORT_SYMBOL_GPL(rtac86u_bootdiag_complete);
+
+static int rtac86u_bootdiag_panic(struct notifier_block *nb,
+				 unsigned long event, void *data)
+{
+	struct bcm63138_leds *leds = container_of(nb, struct bcm63138_leds,
+						 bootdiag_panic);
+	struct bcm63138_led led = { .pin = 20 };
+	unsigned long flags;
+
+	if (!spin_trylock_irqsave(&rtac86u_bootdiag_lock, flags))
+		return NOTIFY_DONE;
+	if (!spin_trylock(&leds->lock)) {
+		spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+		return NOTIFY_DONE;
+	}
+	leds->bootdiag_panicked = true;
+	bcm63138_leds_set_bright(leds, &led, BCM63138_MAX_BRIGHTNESS);
+	bcm63138_leds_enable_led(leds, &led, BCM63138_MAX_BRIGHTNESS);
+	bcm63138_leds_set_flash_rate(leds, &led, 6);
+	led.pin = 21;
+	bcm63138_leds_enable_led(leds, &led, LED_OFF);
+	spin_unlock(&leds->lock);
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	return NOTIFY_DONE;
+}
+
+static ssize_t boot_stage_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct bcm63138_leds *leds = dev_get_drvdata(dev);
+	unsigned long flags;
+	unsigned int stage, phase;
+	bool panicked;
+
+	spin_lock_irqsave(&leds->lock, flags);
+	stage = leds->bootdiag_stage;
+	phase = leds->bootdiag_phase;
+	panicked = leds->bootdiag_panicked;
+	spin_unlock_irqrestore(&leds->lock, flags);
+	return sysfs_emit(buf, "stage=%u phase=%u panic=%u\n", stage, phase, panicked);
+}
+
+static ssize_t boot_stage_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	unsigned int stage;
+	int err;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	err = kstrtouint(buf, 10, &stage);
+	if (err)
+		return err;
+	if (stage != 13 && stage != 14)
+		return -EINVAL;
+	rtac86u_bootdiag_checkpoint(stage, 1);
+	return count;
+}
+static DEVICE_ATTR_RW(boot_stage);
+
+static void rtac86u_bootdiag_cleanup(void *data)
+{
+	struct bcm63138_leds *leds = data;
+	unsigned long flags;
+
+	atomic_notifier_chain_unregister(&panic_notifier_list,
+					 &leds->bootdiag_panic);
+	spin_lock_irqsave(&rtac86u_bootdiag_lock, flags);
+	rtac86u_bootdiag_controller = NULL;
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	device_remove_file(leds->dev, &dev_attr_boot_stage);
+}
+
+static int rtac86u_bootdiag_start(struct bcm63138_leds *leds)
+{
+	unsigned long flags;
+	int err;
+
+	if (!of_machine_is_compatible("asus,rt-ac86u") ||
+	    !of_property_read_bool(of_root, "asus,rt-ac86u-bootdiag"))
+		return 0;
+	if ((leds->bootdiag_available & GENMASK(21, 16)) != GENMASK(21, 16))
+		return dev_err_probe(leds->dev, -ENODEV, "Diagnostic LED pins unavailable\n");
+	err = device_create_file(leds->dev, &dev_attr_boot_stage);
+	if (err)
+		return err;
+	leds->bootdiag_panic.notifier_call = rtac86u_bootdiag_panic;
+	err = atomic_notifier_chain_register(&panic_notifier_list,
+					    &leds->bootdiag_panic);
+	if (err) {
+		device_remove_file(leds->dev, &dev_attr_boot_stage);
+		return err;
+	}
+	spin_lock_irqsave(&rtac86u_bootdiag_lock, flags);
+	spin_lock(&leds->lock);
+	leds->bootdiag = true;
+	rtac86u_bootdiag_render(leds, 1, 1);
+	rtac86u_bootdiag_controller = leds;
+	spin_unlock(&leds->lock);
+	spin_unlock_irqrestore(&rtac86u_bootdiag_lock, flags);
+	err = devm_add_action_or_reset(leds->dev, rtac86u_bootdiag_cleanup, leds);
+	if (!err)
+		dev_info(leds->dev, "rt-ac86u bootdiag: stage=1 phase=1\n");
+	return err;
+}
+

#!/bin/sh
# <FILE>target/linux/bcm4908/base-files/etc/hotplug.d/iface/96-rt-ac86u-bootdiag</FILE> - <DESC>Record local WAN ifup in the diagnostic boot LED display.</DESC>
# <VERS>VERSION: 0.1.1</VERS>
# <WCTX>Preserve complete WAN checkpoint sysfs commands under unbuffered stdout capture.</WCTX>
# <CLOG>Write the checkpoint and failure log through configurable direct BusyBox echo calls.</CLOG>

case "${1:-}" in
--help)
	printf '%s\n' 'Hotplug: INTERFACE=wan ACTION=ifup records diagnostic checkpoint14; this does not test Internet reachability.' \
		'RTAC86U_DIAG_COMPATIBLE, RTAC86U_DIAG_STAGE and RTAC86U_DIAG_KMSG override test paths.' \
		'RTAC86U_DIAG_BUSYBOX overrides /bin/busybox for atomic command and log writes.'
	exit 0
	;;
esac
[ "${INTERFACE:-}" = 'wan' ] && [ "${ACTION:-}" = 'ifup' ] || exit 0
rtac86u_diag_compatible="${RTAC86U_DIAG_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}"
rtac86u_diag_stage="${RTAC86U_DIAG_STAGE:-/sys/class/leds/lan1/device/boot_stage}"
rtac86u_diag_kmsg="${RTAC86U_DIAG_KMSG:-/dev/kmsg}"
rtac86u_diag_busybox="${RTAC86U_DIAG_BUSYBOX:-/bin/busybox}"
[ -r "$rtac86u_diag_compatible" ] && [ -e "$rtac86u_diag_stage" ] || exit 0
tr '\000' '\n' < "$rtac86u_diag_compatible" | grep -Fxq 'asus,rt-ac86u' || exit 0
if ! "$rtac86u_diag_busybox" echo '14' > "$rtac86u_diag_stage"; then
	"$rtac86u_diag_busybox" echo '<4>rt-ac86u-bootdiag: WAN checkpoint write failed' > "$rtac86u_diag_kmsg" 2>/dev/null || :
fi
exit 0

# <FILE>target/linux/bcm4908/base-files/etc/hotplug.d/iface/96-rt-ac86u-bootdiag</FILE> - <DESC>Record local WAN ifup in the diagnostic boot LED display.</DESC>
# <VERS>END OF VERSION: 0.1.1</VERS>

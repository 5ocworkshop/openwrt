#!/bin/sh /etc/rc.common
# <FILE>target/linux/bcm4908/base-files/etc/init.d/ac86u-radio-recover</FILE> - <DESC>Run the bounded AC86U radio startup check once after network boot.</DESC>
# <VERS>VERSION: 0.1.0</VERS>
# <WCTX>Provide a single boot recovery instance without ongoing traffic supervision.</WCTX>
# <CLOG>Start the scoped helper once through procd after normal module and network startup.</CLOG>
export START=22 USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/ac86u-radio-recover
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
# <FILE>target/linux/bcm4908/base-files/etc/init.d/ac86u-radio-recover</FILE> - <DESC>Run the bounded AC86U radio startup check once after network boot.</DESC>
# <VERS>END OF VERSION: 0.1.0</VERS>

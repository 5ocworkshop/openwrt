#!/bin/sh
# <FILE>target/linux/bcm4908/base-files/lib/preinit/99_rt_ac86u_bootdiag</FILE> - <DESC>Record diagnostic userspace preinit progress without requiring networking.</DESC>
# <VERS>VERSION: 0.1.2</VERS>
# <WCTX>Preserve complete preinit sysfs commands under unbuffered stdout capture.</WCTX>
# <CLOG>Write the checkpoint and failure log through configurable direct BusyBox echo calls.</CLOG>

rt_ac86u_bootdiag_preinit() {
	rtac86u_diag_compatible="${RTAC86U_DIAG_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}"
	rtac86u_diag_stage="${RTAC86U_DIAG_STAGE:-/sys/class/leds/lan1/device/boot_stage}"
	rtac86u_diag_kmsg="${RTAC86U_DIAG_KMSG:-/dev/kmsg}"
	rtac86u_diag_busybox="${RTAC86U_DIAG_BUSYBOX:-/bin/busybox}"
	[ -r "$rtac86u_diag_compatible" ] && [ -e "$rtac86u_diag_stage" ] || return 0
	tr '\000' '\n' < "$rtac86u_diag_compatible" | grep -Fxq 'asus,rt-ac86u' || return 0
	if ! "$rtac86u_diag_busybox" echo '13' > "$rtac86u_diag_stage"; then
		"$rtac86u_diag_busybox" echo '<4>rt-ac86u-bootdiag: preinit checkpoint write failed' > "$rtac86u_diag_kmsg" 2>/dev/null || :
	fi
	return 0
}

case "${1:-}" in
--help)
	printf '%s\n' 'Sourced OpenWrt preinit hook: registers checkpoint13 on preinit_essential.' \
		'RTAC86U_DIAG_COMPATIBLE, RTAC86U_DIAG_STAGE and RTAC86U_DIAG_KMSG override test paths.' \
		'RTAC86U_DIAG_BUSYBOX overrides /bin/busybox for atomic command and log writes.'
	;;
*) boot_hook_add preinit_essential rt_ac86u_bootdiag_preinit ;;
esac

# <FILE>target/linux/bcm4908/base-files/lib/preinit/99_rt_ac86u_bootdiag</FILE> - <DESC>Record diagnostic userspace preinit progress without requiring networking.</DESC>
# <VERS>END OF VERSION: 0.1.2</VERS>
